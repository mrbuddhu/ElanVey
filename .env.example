# ---------------------------------------------------------------------------
# Elan Vey — Environment Variables
# Copy this file to `.env.local` for development and set each value in
# Vercel Project Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Site / SEO
# ---------------------------------------------------------------------------
# Canonical URL used in sitemap, robots.txt, canonical links, and OG metadata.
# Production : https://elanvey.com
# Staging    : https://<project>.vercel.app
# Dev        : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://elanvey.com

# ---------------------------------------------------------------------------
# 2. Google Sheets — Waitlist / Lead Storage
# ---------------------------------------------------------------------------
# Google Apps Script Web App URL that appends { email, source, submittedAt }
# to your Google Sheet.  Create one at script.google.com → Deploy → Web app.
# Required by: /api/waitlist, /api/leads
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# ---------------------------------------------------------------------------
# 3. SMTP — Welcome / Auto-reply Email (sent FROM vision@elanvey.com)
# ---------------------------------------------------------------------------
# Outgoing mail host.  Pick ONE:
#   Legacy GoDaddy Workspace Email → smtpout.secureserver.net
#   GoDaddy Microsoft 365 Email    → smtp.office365.com
SMTP_HOST=smtpout.secureserver.net

# Port + TLS mode.  Must match your host:
#   smtpout.secureserver.net → port 465, SMTP_SECURE=true  (SSL)
#   smtp.office365.com       → port 587, SMTP_SECURE=false (STARTTLS)
SMTP_PORT=465
SMTP_SECURE=true

# Mailbox credentials for the FROM address (e.g. vision@elanvey.com).
# For GoDaddy M365 this may need an "App Password" if 2FA is enabled.
SMTP_USER=vision@elanvey.com
SMTP_PASS=REPLACE_WITH_MAILBOX_PASSWORD

# Envelope headers (fallback to SMTP_USER if left blank).
SMTP_FROM_NAME=Elan Vey
SMTP_FROM_ADDRESS=vision@elanvey.com
SMTP_REPLY_TO=vision@elanvey.com
